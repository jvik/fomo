/* fomo global styles */

AuthErrorModal {
    align: center middle;
}

/* 64 columns leave 58 for text (wrapped) and three 16-column buttons;
   the whole dialog fits an 80x24 terminal. */
#auth-error-dialog {
    background: $surface;
    border: thick $error;
    padding: 1 2;
    width: 64;
    max-width: 100%;
    height: auto;
    max-height: 100%;
}

#auth-error-title {
    width: 1fr;
    text-style: bold;
    color: $error;
    margin-bottom: 1;
}

/* width: 1fr makes the labels wrap instead of running past the border. */
#auth-error-body {
    width: 1fr;
    margin-bottom: 1;
}

#auth-error-message {
    width: 1fr;
}

#auth-error-buttons {
    height: auto;
    margin-top: 1;
}

#auth-error-retry, #auth-error-ok {
    width: 1fr;
    margin-right: 1;
}

#auth-error-quit {
    width: 1fr;
}

/* Roles screen "e": the subscriptions that failed to load.  The list
   scrolls, so the dialog fits an 80x24 terminal however many failed. */
LoadErrorsModal {
    align: center middle;
}

#load-errors-dialog {
    background: $surface;
    border: thick $warning;
    padding: 1 2;
    width: 72;
    max-width: 100%;
    height: auto;
    max-height: 100%;
}

#load-errors-title {
    width: 1fr;
    text-style: bold;
    color: $text-warning;
    margin-bottom: 1;
}

#load-errors-list {
    height: auto;
    max-height: 12;
}

.load-error {
    width: 1fr;
    margin-bottom: 1;
}

#load-errors-buttons {
    height: auto;
}

#load-errors-retry {
    width: 1fr;
    margin-right: 1;
}

#load-errors-close {
    width: 1fr;
}

/* Keys screen (? or F1): this screen's keys and the app-wide ones side by
   side.  The longest list (the scope screen's) fits 80x24 with room to
   spare; on smaller terminals the lists scroll. */
KeysScreen {
    align: center middle;
}

#keys-dialog {
    background: $surface;
    border: thick $primary;
    border-title-color: $text;
    border-title-style: bold;
    padding: 1 3;
    width: auto;
    max-width: 100%;
    height: auto;
    max-height: 100%;
}

#keys-list {
    width: auto;
    height: auto;
    max-height: 70vh;
}

#keys-columns {
    width: auto;
    height: auto;
}

.keys-column {
    width: auto;
    height: auto;
}

.keys-column:first-of-type {
    margin-right: 6;
}

.keys-heading {
    text-style: bold;
    color: $text-muted;
    margin-bottom: 1;
}

#keys-screen, #keys-app {
    width: auto;
}

#keys-hint {
    margin-top: 1;
}

Screen {
    background: $surface;
}

Header {
    background: $primary;
    color: $foreground;
}

/* Shared layout */
#main {
    padding: 1 2;
    height: 1fr;
}

/* Loading / status labels */
#loading-label {
    margin: 1 0;
    color: $text-muted;
    text-style: italic;
}

/* One line, two while subscriptions failed to load ("⚠ … · e details"). */
#status {
    height: auto;
    max-height: 2;
    color: $text-muted;
    margin-top: 1;
}

/* Scope screen */
SelectionList {
    height: 1fr;
    border: round $panel;
}

/* SelectionList toggle colours, all readable on the $panel toggle background
   in both themes.  $text-success is the success colour adjusted for
   legibility: plain $success on $panel is only 3.6:1 in the light theme.
   FomoSelectionList also makes a selected row's ◉ and text bold. */
SelectionList > .selection-list--button {
    color: $text-muted;
}

SelectionList > .selection-list--button-highlighted {
    color: $text;
}

SelectionList > .selection-list--button-selected {
    color: $text-success;
}

SelectionList > .selection-list--button-selected-highlighted {
    color: $text-success;
}

/* Roles screen */
#filter {
    margin: 1 0;
}

/* Split-view selection screens (roles + entra) */
#loading-area {
    padding: 1 2;
    height: 1fr;
}

#split {
    height: 1fr;
}

#left-pane {
    width: 2fr;
    padding: 0 1;
}

#detail-pane {
    width: 1fr;
    border-left: solid $panel;
    padding: 1 2;
    overflow-y: auto;
    background: $boost;
}

#detail {
    width: 1fr;
    height: auto;
}

/* Tables (activation and assignments screens) */
DataTable {
    height: auto;
    max-height: 14;
    border: round $panel;
    margin-bottom: 1;
}

/* Activation screens, top to bottom: title, reason + duration, the role
   tables (the only part that grows and scrolls), error details, buttons,
   then a blank row above the footer.  The form and the buttons stay on
   screen at 80x24 even after failures. */
#activation {
    padding: 1 2;
    height: 1fr;
}

#title {
    height: 1;
}

#form {
    height: 3;
}

#form .form-label {
    height: 3;
    content-align: left middle;
    color: $text-muted;
    margin-right: 1;
}

#justification {
    width: 1fr;
}

#duration-label {
    margin-left: 2;
}

#duration {
    width: 18;
}

#roles-scroll {
    height: 1fr;
}

/* #roles-scroll only takes focus while rows are out of view.  Its tables'
   frames show the focus; same border type, so nothing moves. */
#roles-scroll:focus DataTable {
    border: round $border;
}

/* Full height (DataTable's default max-height is 100%): #roles-scroll does
   the scrolling.  The columns always fit, so no horizontal scrollbar. */
#roles-scroll DataTable {
    max-height: 999;
    overflow-x: hidden;
    margin-bottom: 0;
}

/* Global assignments warning box */
#global-roles-box {
    height: auto;
    border: round $warning;
    padding: 0 1;
}

#global-roles-box Label {
    color: $text;
}

/* Error details panel (shown only after activation errors) */
#error-log {
    height: auto;
    max-height: 8;
    border: round $error;
    border-title-color: $error;
    background: $surface-darken-1;
}

/* Bottom right: [Back] [Activate], the primary button rightmost. */
#buttons {
    height: 3;
    align: right middle;
}

#btn-back {
    margin-right: 2;
}

/* Scope screen tabs */
#scope-tabs {
    height: 1fr;
}

#tab-hint {
    height: 1;
    padding: 0 1;
    color: $text-muted;
    background: $panel;
}

/* Entra tab pane within ScopeScreen */
#entra-loading-area {
    padding: 1 2;
    height: 1fr;
}

#entra-split {
    height: 1fr;
}

#entra-left-pane {
    width: 2fr;
    padding: 0 1;
}

#entra-detail-pane {
    width: 1fr;
    border-left: solid $panel;
    padding: 1 2;
    overflow-y: auto;
    background: $boost;
}

#entra-detail {
    width: 1fr;
    height: auto;
}

#entra-filter {
    margin: 1 0;
}

#entra-status {
    height: 1;
    color: $text-muted;
    margin-top: 1;
}

/* Assignments screen */
#assignment-tabs {
    height: 1fr;
}

#azure-table, #entra-table {
    height: 1fr;
    max-height: 100;
    margin-top: 1;
}

.hidden {
    display: none;
}
